.equ HELIX_FOSSIL, 1
.equ DOME_FOSSIL,  2
.equ OLD_AMBER,    3
.equ CLAW_FOSSIL,  4

CinnabarIsland_PokemonLab_ExperimentRoom_MapScripts::
	.byte 0

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_Garett::
	lock
	faceplayer
	setvar VAR_0x8008, INGAME_TRADE_SEEL
	call EventScript_GetInGameTradeSpeciesInfo
	goto_if_set FLAG_DID_SEELOR_TRADE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_AlreadyTraded
	msgbox Trade_Text_LookingForMonWannaTradeForMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_DeclineTrade
	call EventScript_ChooseMonForInGameTrade
	goto_if_ge VAR_0x8004, PARTY_SIZE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_DeclineTrade
	call EventScript_GetInGameTradeSpecies
	goto_if_ne VAR_RESULT, VAR_0x8009, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_NotRequestedMon
	call EventScript_DoInGameTrade
	msgbox Trade_Text_HeyThanks
	setflag FLAG_DID_SEELOR_TRADE
	release
	end

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_DeclineTrade::
	msgbox Trade_Text_AwwOhWell
	release
	end

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_NotRequestedMon::
	bufferspeciesname STR_VAR_1, VAR_0x8009
	msgbox Trade_Text_WhatThatsNoMon
	release
	end

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_AlreadyTraded::
	msgbox Trade_Text_IsntMyOldMonGreat
	release
	end

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_FossilScientist::
	lock
	faceplayer
	@ A pending restoration takes priority over the new one-time gift.
	goto_if_ne VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_REVIVE_STATE, 0, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_RevivalService
	goto_if_set FLAG_GOT_UNCHOSEN_MT_MOON_FOSSIL, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_RevivalService
	goto_if_unset FLAG_GOT_FOSSIL_FROM_MT_MOON, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_RevivalService
	@ Original choice flags stay immutable, including on older saves.
	goto_if_set FLAG_GOT_HELIX_FOSSIL, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_OfferDomeGift
	goto_if_set FLAG_GOT_DOME_FOSSIL, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_OfferHelixGift
	goto CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_RevivalService

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_OfferDomeGift::
	goto_if_set FLAG_GOT_DOME_FOSSIL, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_RevivalService
	setvar VAR_0x8008, ITEM_DOME_FOSSIL
	goto CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_OfferUnchosenFossil

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_OfferHelixGift::
	setvar VAR_0x8008, ITEM_HELIX_FOSSIL
	goto CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_OfferUnchosenFossil

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_OfferUnchosenFossil::
	bufferitemname STR_VAR_1, VAR_0x8008
	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_OfferUnchosenFossil, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_EndGiveMon
	checkitemspace VAR_0x8008, 1
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_NoRoomForFossil
	giveitem VAR_0x8008, 1
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_NoRoomForFossil
	setflag FLAG_GOT_UNCHOSEN_MT_MOON_FOSSIL
	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_ReviveUnchosenFossil
	release
	end

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_NoRoomForFossil::
	bufferitemname STR_VAR_2, VAR_0x8008
	msgbox Aide_Text_DontHaveAnyRoomForItem
	release
	end

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_RevivalService::
	goto_if_eq VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_REVIVE_STATE, 2, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_GiveRevivedMon
	goto_if_eq VAR_MAP_SCENE_CINNABAR_ISLAND_POKEMON_LAB_EXPERIMENT_ROOM_REVIVE_STATE, 1, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_FossilStillReviving
	message CinnabarIsland_PokemonLab_ExperimentRoom_Text_HaveYouAFossilForMe
	waitmessage
	multichoice 0, 0, MULTICHOICE_FOSSIL_REVIVAL, FALSE
	switch VAR_RESULT
	case 0, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_CheckHelix
	case 1, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_CheckDome
	case 2, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_CheckAmber
	case 3, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_CheckClaw
	goto CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_DontShowFossil

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_CheckHelix::
	goto_if_set FLAG_REVIVED_HELIX, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_UnavailableFossil
	checkitem ITEM_HELIX_FOSSIL, 1
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_UnavailableFossil
	goto CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_ShowHelixFossil

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_CheckDome::
	goto_if_set FLAG_REVIVED_DOME, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_UnavailableFossil
	checkitem ITEM_DOME_FOSSIL, 1
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_UnavailableFossil
	goto CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_ShowDomeFossil

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_CheckAmber::
	goto_if_set FLAG_REVIVED_AMBER, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_UnavailableFossil
	checkitem ITEM_OLD_AMBER, 1
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_UnavailableFossil
	goto CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_ShowOldAmber

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_CheckClaw::
	goto_if_set FLAG_REVIVED_CLAW, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_UnavailableFossil
	checkitem ITEM_CLAW_FOSSIL, 1
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_UnavailableFossil
	goto CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_ShowClawFossil

CinnabarIsland_PokemonLab_ExperimentRoom_EventScript_UnavailableFossil::
	msgbox CinnabarIsland_PokemonLab_ExperimentRoom_Text_UnavailableFossil
	release
	end

