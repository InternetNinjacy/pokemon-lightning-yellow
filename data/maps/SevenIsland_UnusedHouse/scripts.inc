SevenIsland_UnusedHouse_MapScripts::
	.byte 0

SevenIsland_UnusedHouse_EventScript_BattleTowerReceptionist::
	lock
	faceplayer
	// Recover an outstanding in-memory party snapshot before reception actions.
	// A fresh visit without a snapshot leaves the party untouched.
	special RestoreSevenIslandBattleTowerParty
	msgbox SevenIsland_UnusedHouse_Text_BattleTowerReceptionist
	msgbox SevenIsland_UnusedHouse_Text_ChooseLevel50, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SevenIsland_UnusedHouse_EventScript_Level50
	msgbox SevenIsland_UnusedHouse_Text_ChooseLevel100, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SevenIsland_UnusedHouse_EventScript_Level100
	goto SevenIsland_UnusedHouse_EventScript_OfferReturn

SevenIsland_UnusedHouse_EventScript_Level50::
	setvar VAR_RESULT, 0
	special CheckPartyBattleTowerBanlist
	goto SevenIsland_UnusedHouse_EventScript_CheckEligibility

SevenIsland_UnusedHouse_EventScript_Level100::
	setvar VAR_RESULT, 1
	special CheckPartyBattleTowerBanlist
	goto SevenIsland_UnusedHouse_EventScript_CheckEligibility

SevenIsland_UnusedHouse_EventScript_CheckEligibility::
	goto_if_eq VAR_0x8004, 1, SevenIsland_UnusedHouse_EventScript_Ineligible
	msgbox SevenIsland_UnusedHouse_Text_ChooseThree, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, SevenIsland_UnusedHouse_EventScript_OfferReturn
	closemessage
	special ChooseBattleTowerPlayerParty
	waitstate
	goto_if_eq VAR_RESULT, 0, SevenIsland_UnusedHouse_EventScript_SelectionCancelled
	setvar VAR_0x8004, 5
	special SetBattleTowerProperty
	msgbox SevenIsland_UnusedHouse_Text_SelectionSaved
	goto SevenIsland_UnusedHouse_EventScript_OfferReturn

SevenIsland_UnusedHouse_EventScript_SelectionCancelled::
	msgbox SevenIsland_UnusedHouse_Text_SelectionCancelled
	goto SevenIsland_UnusedHouse_EventScript_OfferReturn

SevenIsland_UnusedHouse_EventScript_Ineligible::
	msgbox SevenIsland_UnusedHouse_Text_NeedThreeEligible
	goto SevenIsland_UnusedHouse_EventScript_OfferReturn

SevenIsland_UnusedHouse_EventScript_OfferReturn::
	msgbox SevenIsland_UnusedHouse_Text_OfferHealing, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, SevenIsland_UnusedHouse_EventScript_ReturnPrompt
	special HealPlayerParty
	msgbox SevenIsland_UnusedHouse_Text_Healed

SevenIsland_UnusedHouse_EventScript_ReturnPrompt::
	msgbox SevenIsland_UnusedHouse_Text_ReturnToSevenIsland, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, SevenIsland_UnusedHouse_EventScript_Stay
	closemessage
	// Never escort a player away while a runtime party snapshot remains.
	special RestoreSevenIslandBattleTowerParty
	warp MAP_SEVEN_ISLAND, 15, 6
	waitstate
	release
	end

SevenIsland_UnusedHouse_EventScript_Stay::
	release
	end
